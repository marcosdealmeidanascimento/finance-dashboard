# Template with no secrets: every sensitive value comes from an environment variable.
# The Docker image uses this file as its application.properties (see Dockerfile);
# for local runs, copy it to application.properties and fill in the values.
spring.application.name=dashboard

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=${JPA_SHOW_SQL:false}

# Flyway applies db/migration on startup (before Hibernate validates the schema).
# Databases created before Flyway already have V1-V4 applied by hand: the first run just records
# version 4 as the baseline. Empty databases run every migration from V1.
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=4

jwt.secret=${JWT_SECRET}

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/fin_dashboard}
spring.datasource.username=${DB_USERNAME:fin_dashboard_user}
spring.datasource.password=${DB_PASSWORD}

spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# MinIO. The endpoint is embedded in presigned image URLs, so it must be reachable from the phone (LAN IP).
storage.endpoint=${STORAGE_ENDPOINT:http://localhost:9000}
storage.bucket=${STORAGE_BUCKET:finances-dashboard}
storage.access-key=${STORAGE_ACCESS_KEY}
storage.secret-key=${STORAGE_SECRET_KEY}

# Browser origins allowed to call the API (comma-separated). Irrelevant for the native app.
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:8081}

spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB
